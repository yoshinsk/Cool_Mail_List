# C:\Users\Yoshi\Documents\GitHub\Cool_Mail_List\.env.example
# Cool Mail List の環境変数サンプル。実運用の秘密情報は .env のみに保存し、Git 管理しない。

APP_NAME="Cool Mail List"
APP_ENV=production
APP_URL=https://mail.example.com
APP_TIMEZONE=Asia/Tokyo
APP_KEY=change-me-generate-32bytes-random
APP_COOKIE_SECURE=1

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mailerdb
DB_USER=mailerdb
DB_PASS=change-me

QUEUE_BATCH_LIMIT=5
BOUNCE_DOMAIN=example.com
BOUNCE_BASE_EMAIL=bounce@example.com
DEFAULT_FROM_NAME="Cool Mail List"

SYSTEM_MAIL_FROM=no-reply@example.com
SYSTEM_MAIL_FROM_NAME="Cool Mail List"
SYSTEM_SMTP_HOST=smtp.example.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_ENCRYPTION=tls
SYSTEM_SMTP_USER=no-reply@example.com
SYSTEM_SMTP_PASS=change-me

BOUNCE_IMAP_HOST=imap.example.com
BOUNCE_IMAP_PORT=993
BOUNCE_IMAP_ENCRYPTION=ssl
BOUNCE_IMAP_USER=bounce@example.com
BOUNCE_IMAP_PASS=change-me
BOUNCE_IMAP_MAILBOX=INBOX
BOUNCE_IMAP_SEARCH=UNSEEN
BOUNCE_IMAP_MARK_SEEN=1

GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAIN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
